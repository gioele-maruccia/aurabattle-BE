# Ignore exported data (may contain sensitive info)
exported-data/
*.json
!config.json
!events/*.json

# Ignore Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Ignore local environment info
.local-env-info.json

# Ignore logs
*.log

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo
