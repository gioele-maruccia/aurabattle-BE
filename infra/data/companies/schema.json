{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["userId", "companyId", "businessName"],
  "properties": {
    "userId": {
      "type": "string",
      "description": "Cognito sub"
    },
    "companyId": {
      "type": "string",
      "format": "uuid"
    },
    "businessName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200
    },
    "vatNumber": {
      "type": "string",
      "pattern": "^[A-Z]{2}[0-9]{10}$"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "location": {
      "type": "object",
      "required": ["city", "country"],
      "properties": {
        "city": { "type": "string" },
        "country": { "type": "string" },
        "coordinates": {
          "type": "object",
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lon": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        }
      }
    }
  }
}