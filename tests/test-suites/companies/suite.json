{
  "suite": "companies-complete",
  "description": "Complete test suite for Companies API",
  "baseEndpoint": "/companies",
  "tests": [
    {
      "id": "create-company-valid",
      "name": "Create Company - Valid Data",
      "description": "Test creating a minimal company profile with valid businessName and vatNumber",
      "method": "POST",
      "endpoint": "/companies",
      "auth": "company",
      "payload": "payloads/create-company-valid.json",
      "expectedStatus": 201,
      "assertions": [
        {
          "type": "status",
          "value": 201
        },
        {
          "type": "jsonPath",
          "path": "$.company.companyId",
          "exists": true
        },
        {
          "type": "jsonPath",
          "path": "$.company.userId",
          "exists": true
        },
        {
          "type": "jsonPath",
          "path": "$.company.businessName",
          "value": "KFC Belgium Test"
        },
        {
          "type": "jsonPath",
          "path": "$.company.vatNumber",
          "value": "BE0123456789"
        },
        {
          "type": "jsonPath",
          "path": "$.company.status",
          "value": "active"
        },
        {
          "type": "jsonPath",
          "path": "$.message",
          "contains": "Company created successfully"
        },
        {
          "type": "jsonPath",
          "path": "$.nextSteps.endpoint",
          "exists": true
        }
      ]
    },
    {
      "id": "create-company-duplicate",
      "name": "Create Company - Duplicate (Already Exists)",
      "description": "Test error when trying to create a company for a user who already has one",
      "method": "POST",
      "endpoint": "/companies",
      "auth": "company",
      "payload": "payloads/create-company-valid.json",
      "expectedStatus": 409,
      "assertions": [
        {
          "type": "status",
          "value": 409
        },
        {
          "type": "jsonPath",
          "path": "$.error",
          "value": "CompanyAlreadyExists"
        },
        {
          "type": "jsonPath",
          "path": "$.message",
          "contains": "already exists"
        },
        {
          "type": "jsonPath",
          "path": "$.companyId",
          "exists": true
        }
      ]
    },
    {
      "id": "create-company-invalid-vat",
      "name": "Create Company - Invalid VAT Number",
      "description": "Test validation error for invalid VAT number format",
      "method": "POST",
      "endpoint": "/companies",
      "auth": "company",
      "payload": "payloads/create-company-invalid-vat.json",
      "expectedStatus": 400,
      "assertions": [
        {
          "type": "status",
          "value": 400
        },
        {
          "type": "jsonPath",
          "path": "$.error",
          "value": "ValidationError"
        },
        {
          "type": "jsonPath",
          "path": "$.message",
          "contains": "vatNumber must follow format"
        }
      ]
    },
    {
      "id": "create-company-missing-fields",
      "name": "Create Company - Missing Required Fields",
      "description": "Test error when required fields are missing",
      "method": "POST",
      "endpoint": "/companies",
      "auth": "company",
      "payload": "payloads/create-company-missing-fields.json",
      "expectedStatus": 400,
      "assertions": [
        {
          "type": "status",
          "value": 400
        },
        {
          "type": "jsonPath",
          "path": "$.error",
          "value": "ValidationError"
        },
        {
          "type": "jsonPath",
          "path": "$.message",
          "contains": "Missing required field"
        }
      ]
    },
    {
      "id": "create-company-short-name",
      "name": "Create Company - Business Name Too Short",
      "description": "Test validation error for business name that's too short",
      "method": "POST",
      "endpoint": "/companies",
      "auth": "company",
      "payload": "payloads/create-company-short-name.json",
      "expectedStatus": 400,
      "assertions": [
        {
          "type": "status",
          "value": 400
        },
        {
          "type": "jsonPath",
          "path": "$.error",
          "value": "ValidationError"
        },
        {
          "type": "jsonPath",
          "path": "$.message",
          "contains": "between 2 and 200 characters"
        }
      ]
    },
    {
      "id": "create-company-unauthorized-worker",
      "name": "Create Company - Unauthorized Worker",
      "description": "Test that workers cannot create company profiles",
      "method": "POST",
      "endpoint": "/companies",
      "auth": "worker",
      "payload": "payloads/create-company-valid.json",
      "expectedStatus": 403,
      "assertions": [
        {
          "type": "status",
          "value": 403
        },
        {
          "type": "jsonPath",
          "path": "$.error",
          "value": "Forbidden"
        }
      ]
    },
    {
      "id": "create-company-no-auth",
      "name": "Create Company - No Authentication",
      "description": "Test that unauthenticated users cannot create companies",
      "method": "POST",
      "endpoint": "/companies",
      "auth": "none",
      "payload": "payloads/create-company-valid.json",
      "expectedStatus": 401,
      "assertions": [
        {
          "type": "status",
          "value": 401
        }
      ]
    },
    {
      "id": "update-company-description",
      "name": "Update Company - Add Description and Location",
      "description": "Test updating company profile with description and location",
      "method": "PUT",
      "endpoint": "/companies/{userId}",
      "auth": "company",
      "dynamicParams": {
        "userId": "fromPreviousTest:create-company-valid:$.company.userId"
      },
      "payload": "payloads/update-company-description.json",
      "expectedStatus": 200,
      "assertions": [
        {
          "type": "status",
          "value": 200
        },
        {
          "type": "jsonPath",
          "path": "$.company.description",
          "contains": "Fast food chain"
        },
        {
          "type": "jsonPath",
          "path": "$.company.location.city",
          "value": "Mechelen"
        },
        {
          "type": "jsonPath",
          "path": "$.company.location.country",
          "value": "Belgium"
        },
        {
          "type": "jsonPath",
          "path": "$.company.location.coordinates.lat",
          "exists": true
        },
        {
          "type": "jsonPath",
          "path": "$.message",
          "contains": "updated successfully"
        }
      ]
    },
    {
      "id": "update-company-request-images",
      "name": "Update Company - Request Presigned URLs for Images",
      "description": "Test requesting presigned URLs for profile and gallery images",
      "method": "PUT",
      "endpoint": "/companies/{userId}",
      "auth": "company",
      "dynamicParams": {
        "userId": "fromPreviousTest:create-company-valid:$.company.userId"
      },
      "payload": "payloads/update-company-request-images.json",
      "expectedStatus": 200,
      "assertions": [
        {
          "type": "status",
          "value": 200
        },
        {
          "type": "jsonPath",
          "path": "$.uploadUrls.profileImage.uploadUrl",
          "exists": true
        },
        {
          "type": "jsonPath",
          "path": "$.uploadUrls.profileImage.key",
          "contains": "profile.jpg"
        },
        {
          "type": "jsonPath",
          "path": "$.uploadUrls.galleryImages",
          "exists": true
        },
        {
          "type": "jsonPath",
          "path": "$.uploadInstructions.expiresIn",
          "value": 3600
        },
        {
          "type": "jsonPath",
          "path": "$.uploadInstructions.method",
          "value": "PUT"
        }
      ]
    },
    {
      "id": "update-company-save-media",
      "name": "Update Company - Save Media URLs",
      "description": "Test saving uploaded image URLs to company profile",
      "method": "PUT",
      "endpoint": "/companies/{userId}",
      "auth": "company",
      "dynamicParams": {
        "userId": "fromPreviousTest:create-company-valid:$.company.userId"
      },
      "payload": "payloads/update-company-save-media.json",
      "expectedStatus": 200,
      "assertions": [
        {
          "type": "status",
          "value": 200
        },
        {
          "type": "jsonPath",
          "path": "$.company.media.profileImageUrl",
          "contains": "profile.jpg"
        },
        {
          "type": "jsonPath",
          "path": "$.company.media.galleryImages",
          "exists": true
        }
      ]
    },
    {
      "id": "update-company-invalid-coordinates",
      "name": "Update Company - Invalid Coordinates",
      "description": "Test validation error for invalid coordinates",
      "method": "PUT",
      "endpoint": "/companies/{userId}",
      "auth": "company",
      "dynamicParams": {
        "userId": "fromPreviousTest:create-company-valid:$.company.userId"
      },
      "payload": "payloads/update-company-invalid-coordinates.json",
      "expectedStatus": 400,
      "assertions": [
        {
          "type": "status",
          "value": 400
        },
        {
          "type": "jsonPath",
          "path": "$.error",
          "value": "ValidationError"
        },
        {
          "type": "jsonPath",
          "path": "$.message",
          "contains": "latitude must be between"
        }
      ]
    },
    {
      "id": "update-company-missing-city",
      "name": "Update Company - Missing Required Location Field",
      "description": "Test error when location is provided but city is missing",
      "method": "PUT",
      "endpoint": "/companies/{userId}",
      "auth": "company",
      "dynamicParams": {
        "userId": "fromPreviousTest:create-company-valid:$.company.userId"
      },
      "payload": "payloads/update-company-missing-city.json",
      "expectedStatus": 400,
      "assertions": [
        {
          "type": "status",
          "value": 400
        },
        {
          "type": "jsonPath",
          "path": "$.error",
          "value": "ValidationError"
        },
        {
          "type": "jsonPath",
          "path": "$.message",
          "contains": "city is required"
        }
      ]
    },
    {
      "id": "update-company-description-too-long",
      "name": "Update Company - Description Too Long",
      "description": "Test validation error for description exceeding 2000 characters",
      "method": "PUT",
      "endpoint": "/companies/{userId}",
      "auth": "company",
      "dynamicParams": {
        "userId": "fromPreviousTest:create-company-valid:$.company.userId"
      },
      "payload": "payloads/update-company-description-too-long.json",
      "expectedStatus": 400,
      "assertions": [
        {
          "type": "status",
          "value": 400
        },
        {
          "type": "jsonPath",
          "path": "$.error",
          "value": "ValidationError"
        },
        {
          "type": "jsonPath",
          "path": "$.message",
          "contains": "must not exceed 2000 characters"
        }
      ]
    },
    {
      "id": "update-company-not-owner",
      "name": "Update Company - Not Owner (Forbidden)",
      "description": "Test that a company cannot update another company's profile",
      "method": "PUT",
      "endpoint": "/companies/{userId}",
      "auth": "company2",
      "dynamicParams": {
        "userId": "fromPreviousTest:create-company-valid:$.company.userId"
      },
      "payload": "payloads/update-company-description.json",
      "expectedStatus": 403,
      "assertions": [
        {
          "type": "status",
          "value": 403
        },
        {
          "type": "jsonPath",
          "path": "$.error",
          "value": "Forbidden"
        },
        {
          "type": "jsonPath",
          "path": "$.message",
          "contains": "your own company profile"
        }
      ]
    },
    {
      "id": "update-company-not-found",
      "name": "Update Company - Company Not Found",
      "description": "Test error when trying to update non-existent company",
      "method": "PUT",
      "endpoint": "/companies/00000000-0000-0000-0000-000000000000",
      "auth": "company",
      "payload": "payloads/update-company-description.json",
      "expectedStatus": 404,
      "assertions": [
        {
          "type": "status",
          "value": 404
        },
        {
          "type": "jsonPath",
          "path": "$.error",
          "value": "CompanyNotFound"
        },
        {
          "type": "jsonPath",
          "path": "$.message",
          "contains": "not found"
        }
      ]
    },
    {
      "id": "get-company-by-userid",
      "name": "Get Company - By User ID (Authenticated)",
      "description": "Test retrieving company profile by userId",
      "method": "GET",
      "endpoint": "/companies/{userId}",
      "auth": "company",
      "dynamicParams": {
        "userId": "fromPreviousTest:create-company-valid:$.company.userId"
      },
      "expectedStatus": 200,
      "assertions": [
        {
          "type": "status",
          "value": 200
        },
        {
          "type": "jsonPath",
          "path": "$.companyId",
          "exists": true
        },
        {
          "type": "jsonPath",
          "path": "$.userId",
          "exists": true
        },
        {
          "type": "jsonPath",
          "path": "$.businessName",
          "exists": true
        },
        {
          "type": "jsonPath",
          "path": "$.vatNumber",
          "exists": true
        },
        {
          "type": "jsonPath",
          "path": "$.media.profileImageUrl",
          "exists": true
        }
      ]
    },
    {
      "id": "get-company-by-userid-not-found",
      "name": "Get Company - User ID Not Found",
      "description": "Test 404 error for non-existent userId",
      "method": "GET",
      "endpoint": "/companies/00000000-0000-0000-0000-000000000000",
      "auth": "company",
      "expectedStatus": 404,
      "assertions": [
        {
          "type": "status",
          "value": 404
        },
        {
          "type": "jsonPath",
          "path": "$.error",
          "value": "CompanyNotFound"
        }
      ]
    },
    {
      "id": "get-company-public",
      "name": "Get Company - Public Endpoint (No Auth)",
      "description": "Test retrieving company by companyId without authentication",
      "method": "GET",
      "endpoint": "/companies/public/{companyId}",
      "auth": "none",
      "dynamicParams": {
        "companyId": "fromPreviousTest:create-company-valid:$.company.companyId"
      },
      "expectedStatus": 200,
      "assertions": [
        {
          "type": "status",
          "value": 200
        },
        {
          "type": "jsonPath",
          "path": "$.companyId",
          "exists": true
        },
        {
          "type": "jsonPath",
          "path": "$.businessName",
          "exists": true
        },
        {
          "type": "jsonPath",
          "path": "$.description",
          "exists": true
        },
        {
          "type": "jsonPath",
          "path": "$.location",
          "exists": true
        },
        {
          "type": "jsonPath",
          "path": "$.stats",
          "exists": true
        }
      ]
    },
    {
      "id": "get-company-public-not-found",
      "name": "Get Company Public - Not Found",
      "description": "Test 404 error for non-existent companyId on public endpoint",
      "method": "GET",
      "endpoint": "/companies/public/00000000-0000-0000-0000-000000000000",
      "auth": "none",
      "expectedStatus": 404,
      "assertions": [
        {
          "type": "status",
          "value": 404
        },
        {
          "type": "jsonPath",
          "path": "$.error",
          "value": "CompanyNotFound"
        }
      ]
    },
    {
      "id": "delete-company-success",
      "name": "Delete Company - Soft Delete Success",
      "description": "Test soft deleting a company (sets status to deleted)",
      "method": "DELETE",
      "endpoint": "/companies/{userId}",
      "auth": "company",
      "dynamicParams": {
        "userId": "fromPreviousTest:create-company-valid:$.company.userId"
      },
      "expectedStatus": 200,
      "assertions": [
        {
          "type": "status",
          "value": 200
        },
        {
          "type": "jsonPath",
          "path": "$.message",
          "contains": "deleted successfully"
        },
        {
          "type": "jsonPath",
          "path": "$.companyId",
          "exists": true
        },
        {
          "type": "jsonPath",
          "path": "$.deletedAt",
          "exists": true
        },
        {
          "type": "jsonPath",
          "path": "$.note",
          "contains": "soft delete"
        }
      ]
    },
    {
      "id": "delete-company-already-deleted",
      "name": "Delete Company - Already Deleted",
      "description": "Test deleting a company that's already been deleted",
      "method": "DELETE",
      "endpoint": "/companies/{userId}",
      "auth": "company",
      "dynamicParams": {
        "userId": "fromPreviousTest:create-company-valid:$.company.userId"
      },
      "expectedStatus": 200,
      "assertions": [
        {
          "type": "status",
          "value": 200
        },
        {
          "type": "jsonPath",
          "path": "$.message",
          "contains": "already deleted"
        }
      ]
    },
    {
      "id": "delete-company-not-owner",
      "name": "Delete Company - Not Owner (Forbidden)",
      "description": "Test that a company cannot delete another company's profile",
      "method": "DELETE",
      "endpoint": "/companies/{userId}",
      "auth": "company2",
      "dynamicParams": {
        "userId": "fromPreviousTest:create-company-valid:$.company.userId"
      },
      "expectedStatus": 403,
      "assertions": [
        {
          "type": "status",
          "value": 403
        },
        {
          "type": "jsonPath",
          "path": "$.error",
          "value": "Forbidden"
        },
        {
          "type": "jsonPath",
          "path": "$.message",
          "contains": "your own company profile"
        }
      ]
    },
    {
      "id": "delete-company-not-found",
      "name": "Delete Company - Not Found",
      "description": "Test error when trying to delete non-existent company",
      "method": "DELETE",
      "endpoint": "/companies/00000000-0000-0000-0000-000000000000",
      "auth": "company",
      "expectedStatus": 404,
      "assertions": [
        {
          "type": "status",
          "value": 404
        },
        {
          "type": "jsonPath",
          "path": "$.error",
          "value": "CompanyNotFound"
        }
      ]
    }
  ]
}